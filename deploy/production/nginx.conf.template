limit_req_zone $binary_remote_addr zone=gateway_signin:10m rate=5r/m;

server {
    listen 80 default_server;
    server_name ${APP_PUBLIC_HOST};
    return 308 https://${APP_PUBLIC_HOST}$request_uri;
}

server {
    listen 127.0.0.1:8081;
    location = /edge-health { return 200 "ok\n"; }
    location / { return 404; }
}

server {
    listen 443 ssl default_server;
    server_name ${APP_PUBLIC_HOST};
    ssl_certificate /run/secrets/tls_certificate;
    ssl_certificate_key /run/secrets/tls_private_key;
    ssl_protocols TLSv1.2 TLSv1.3;

    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 2m;
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $backend http://backend:8000;

    # Use the original connection address, never a caller-supplied forwarding chain.
    proxy_set_header Host ${APP_PUBLIC_HOST};
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Forwarded "";
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;

    location = /api/v1/auth/login {
        limit_req zone=gateway_signin burst=5 nodelay;
        limit_req_status 429;
        proxy_pass $backend;
    }
    location ^~ /api/v1/ { proxy_pass $backend; }

    location = /v1/models { include /etc/nginx/inference.inc; }
    location = /v1/chat/completions { include /etc/nginx/inference.inc; }
    location = /v1/messages { include /etc/nginx/inference.inc; }
    location ~ ^/(api|v1|internal|key|model|user|team|spend|ui|docs|redoc|openapi\.json|health)(/|$) {
        return 404;
    }

    location /assets/ {
        expires 30d;
        try_files $uri =404;
    }
    location / { try_files $uri $uri/ /index.html; }
}
