# Copy to .env.production on the Linux host.
# Use an immutable release tag and the hostname covered by the TLS certificate.
RELEASE_TAG=replace-with-release-tag
APP_PUBLIC_HOST=gateway.example.invalid
PROD_SECRETS_DIR=/etc/ai-token-gateway/secrets
APP_EDGE_SUBNET=172.30.53.0/24
APP_EDGE_PROXY_IP=172.30.53.10
APP_ENTERPRISE_TIMEZONE=Asia/Shanghai
APP_GATEWAY_INPUT_BOUNDS='{"deepseek-flash":1048576}'
APP_GATEWAY_TPM=12000000
APP_GATEWAY_RPM=60
APP_GATEWAY_PARALLEL=4
APP_GATEWAY_OUTPUT_LIMIT=512
APP_GATEWAY_DEADLINE=120
APP_RISK_INTERVAL=30
