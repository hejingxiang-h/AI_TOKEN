# Copy to .env and replace every REPLACE value before using Compose.
GATEWAY_PORT=8080
POSTGRES_PASSWORD=REPLACE_POSTGRES_ADMIN_PASSWORD
APP_DB_NAME=ai_token_gateway
APP_DB_USER=gateway_app
APP_DB_PASSWORD=REPLACE_APP_DB_PASSWORD
LITELLM_DB_NAME=ai_token_proxy
LITELLM_DB_USER=gateway_proxy
LITELLM_DB_PASSWORD=REPLACE_PROXY_DB_PASSWORD
# Keep role, password and database in sync. Percent-encode the password in this URL.
LITELLM_DATABASE_URL=postgresql://gateway_proxy:REPLACE_PROXY_DB_PASSWORD@postgres:5432/ai_token_proxy
REDIS_PASSWORD=REPLACE_REDIS_PASSWORD
LITELLM_MASTER_KEY=sk-REPLACE_LITELLM_MASTER_KEY
LITELLM_SALT_KEY=REPLACE_LITELLM_SALT_KEY
APP_DOCS_ENABLED=true
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Stage six: provide a random signing secret of at least 32 bytes.
APP_JWT_SECRET=
APP_SECURE_COOKIES=true
# Optional scoped LiteLLM health credential. Keep the master key in LiteLLM.
APP_LITELLM_ADMIN_KEY=
# Internal inference only. Provision a restricted Virtual Key in LiteLLM.
APP_LITELLM_SERVICE_KEY=
APP_GATEWAY_INPUT_BOUNDS={}
APP_GATEWAY_RESPONSES_ENABLED=false
APP_GATEWAY_CALLBACK_SECRET=
APP_ENTERPRISE_TIMEZONE=Asia/Shanghai

# Trust only the actual reverse proxy address or dedicated subnet.
APP_TRUSTED_FORWARDERS=127.0.0.1
APP_RISK_INTERVAL=30
APP_RISK_FREQUENCY=100
APP_RISK_HIGH_COST_USD=10
APP_RISK_PROVIDER_ERRORS=5
APP_RISK_INVALID_KEYS=10
